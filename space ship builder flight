javascript:(()=>{if(window.__shipGameOff){window.__shipGameOff();return;}const c=document.createElement('canvas');const x=c.getContext('2d');document.body.appendChild(c);c.style.cssText='position:fixed;inset:0;z-index:2147483647;background:#020617;';let W=0,H=0,D=1,raf=0;const K={};const stars=[];const G={cols:7,rows:5,size:34,x:30,y:110,cells:[]};const parts=[{id:'body',color:'#cbd5e1'},{id:'nose',color:'#f8fafc'},{id:'engine',color:'#64748b'},{id:'wing',color:'#94a3b8'}];let part=0,mode='build',msg='';const ship={x:0,y:0,vx:0,vy:0,a:-Math.PI/2,fuel:100,hp:100,score:0};const rocks=[];function rs(){W=innerWidth;H=innerHeight;D=Math.max(1,Math.min(2,devicePixelRatio||1));c.width=W*D;c.height=H*D;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(D,0,0,D,0,0)}function key(c,r){return c+','+r}function get(c,r){return G.cells.find(v=>v.k===key(c,r))}function set(c,r,t){const k=key(c,r),i=G.cells.findIndex(v=>v.k===k);if(i>=0)G.cells.splice(i,1);if(t)G.cells.push({k,c,r,t})}function click(mx,my){if(mode!=='build')return;const c0=Math.floor((mx-G.x)/G.size),r0=Math.floor((my-G.y)/G.size);if(c0<0||r0<0||c0>=G.cols||r0>=G.rows)return;const cur=get(c0,r0);set(c0,r0,cur?null:parts[part].id)}function count(t){return G.cells.filter(v=>v.t===t).length}function launch(){if(G.cells.length<3||count('nose')<1||count('engine')<1){msg='Need 3 parts + nose + engine';return}mode='fly';ship.x=W/2;ship.y=H*0.7;ship.vx=0;ship.vy=0;ship.a=-Math.PI/2;ship.fuel=100;ship.hp=100;ship.score=0;rocks.length=0;for(let i=0;i<7;i++)spawn()}function spawn(){const s=(Math.random()*4)|0;let px,py;if(s===0){px=-30;py=Math.random()*H}else if(s===1){px=W+30;py=Math.random()*H}else if(s===2){px=Math.random()*W;py=-30}else{px=Math.random()*W;py=H+30}const a=Math.atan2(ship.y-py,ship.x-px)+(Math.random()-0.5)*0.7,v=1+Math.random()*1.8;rocks.push({x:px,y:py,vx:Math.cos(a)*v,vy:Math.sin(a)*v,r:14+Math.random()*14})}function shipBlocks(){const minC=Math.min(...G.cells.map(v=>v.c)),minR=Math.min(...G.cells.map(v=>v.r));return G.cells.map(v=>({x:(v.c-minC)*16-24,y:(v.r-minR)*16-18,t:v.t}))}function drawPart(t,x0,y0,s){x.fillStyle=(parts.find(p=>p.id===t)||parts[0]).color;if(t==='wing'){x.beginPath();x.moveTo(x0,y0+s/2);x.lineTo(x0+s,y0);x.lineTo(x0+s,y0+s);x.closePath();x.fill();return}if(t==='nose'){x.beginPath();x.moveTo(x0+s,y0+s/2);x.lineTo(x0,y0);x.lineTo(x0,y0+s);x.closePath();x.fill();return}x.fillRect(x0,y0,s,s)}function hitRock(r){const b=shipBlocks();for(const q of b){const rx=Math.cos(ship.a+Math.PI/2)*q.x-Math.sin(ship.a+Math.PI/2)*q.y+ship.x;const ry=Math.sin(ship.a+Math.PI/2)*q.x+Math.cos(ship.a+Math.PI/2)*q.y+ship.y;const nx=Math.max(rx,Math.min(r.x,rx+14)),ny=Math.max(ry,Math.min(r.y,ry+14));const dx=r.x-nx,dy=r.y-ny;if(dx*dx+dy*dy<r.r*r.r)return 1}return 0}function upd(){if(mode!=='fly')return;const turn=((K.ArrowRight||K.d)?1:0)-((K.ArrowLeft||K.a)?1:0);ship.a+=turn*0.05;const thrust=(K.ArrowUp||K.w)&&ship.fuel>0;if(thrust){ship.vx+=Math.cos(ship.a)*0.24;ship.vy+=Math.sin(ship.a)*0.24;ship.fuel=Math.max(0,ship.fuel-0.18)}ship.vx*=0.995;ship.vy*=0.995;ship.x=(ship.x+ship.vx+W)%W;ship.y=(ship.y+ship.vy+H)%H;for(let i=rocks.length-1;i>=0;i--){const r=rocks[i];r.x+=r.vx;r.y+=r.vy;if(r.x<-80||r.y<-80||r.x>W+80||r.y>H+80){rocks.splice(i,1);spawn();continue}if(hitRock(r)){ship.hp-=1.1;rocks.splice(i,1);spawn()}}ship.score+=0.1+Math.hypot(ship.vx,ship.vy)*0.05;if(rocks.length<12&&Math.random()<0.02)spawn();if(ship.hp<=0){mode='build';msg='Ship destroyed! rebuild + Enter'}}function draw(){x.fillStyle='#020617';x.fillRect(0,0,W,H);for(const s of stars){x.fillStyle='rgba(200,220,255,.9)';x.fillRect(s.x,s.y,s.r,s.r);if(mode==='fly'){s.y+=s.v+Math.hypot(ship.vx,ship.vy)*0.1;if(s.y>H)s.y=0}}if(mode==='build'){x.fillStyle='rgba(15,23,42,.85)';x.fillRect(20,20,420,300);x.strokeStyle='rgba(148,163,184,.5)';x.strokeRect(20,20,420,300);x.fillStyle='#fff';x.font='bold 18px sans-serif';x.fillText('Build your spaceship',32,48);x.font='13px sans-serif';x.fillText('Click cells to place/remove parts.',32,70);x.fillText('1-4 select part | Backspace clear | Enter launch',32,88);for(let r=0;r<G.rows;r++)for(let c0=0;c0<G.cols;c0++){x.fillStyle='rgba(51,65,85,.5)';x.fillRect(G.x+c0*G.size,G.y+r*G.size,G.size-1,G.size-1)}for(const v of G.cells)drawPart(v.t,G.x+v.c*G.size+5,G.y+v.r*G.size+5,G.size-10);for(let i=0;i<parts.length;i++){x.fillStyle=i===part?'rgba(59,130,246,.35)':'rgba(30,41,59,.9)';x.fillRect(32+i*95,286,90,26);drawPart(parts[i].id,36+i*95,290,18);x.fillStyle='#e2e8f0';x.fillText((i+1)+': '+parts[i].id,58+i*95,306)}x.fillStyle=msg?'#fca5a5':'#93c5fd';x.fillText(msg||'Need minimum 3 parts, incl. nose + engine',32,336)}else{for(const r of rocks){x.fillStyle='#78716c';x.beginPath();x.arc(r.x,r.y,r.r,0,Math.PI*2);x.fill()}x.save();x.translate(ship.x,ship.y);x.rotate(ship.a+Math.PI/2);for(const q of shipBlocks())drawPart(q.t,q.x,q.y,14);if((K.ArrowUp||K.w)&&ship.fuel>0){x.fillStyle='#fb923c';x.beginPath();x.moveTo(-4,12);x.lineTo(0,26+Math.random()*8);x.lineTo(4,12);x.fill()}x.restore();x.fillStyle='rgba(15,23,42,.85)';x.fillRect(14,14,300,86);x.fillStyle='#e2e8f0';x.font='14px sans-serif';x.fillText('Score '+Math.floor(ship.score),24,36);x.fillText('Fuel',24,58);x.fillStyle='#334155';x.fillRect(62,49,120,10);x.fillStyle='#38bdf8';x.fillRect(62,49,120*(ship.fuel/100),10);x.fillStyle='#e2e8f0';x.fillText('Hull',24,80);x.fillStyle='#334155';x.fillRect(62,71,120,10);x.fillStyle='#22c55e';x.fillRect(62,71,120*(ship.hp/100),10);x.fillText('WASD/Arrows fly | R rebuild | Esc quit',190,36)}}function kd(e){K[e.key]=1;if(e.key==='Escape')off();if(mode==='build'){if(e.key>='1'&&e.key<='4')part=+e.key-1;if(e.key==='Backspace'){G.cells.length=0;msg=''}if(e.key==='Enter')launch()}else if((e.key==='r'||e.key==='R')){mode='build';msg=''}}function ku(e){K[e.key]=0}function md(e){click(e.clientX,e.clientY)}function loop(){upd();draw();raf=requestAnimationFrame(loop)}function off(){cancelAnimationFrame(raf);removeEventListener('resize',rs);removeEventListener('keydown',kd);removeEventListener('keyup',ku);c.removeEventListener('mousedown',md);c.remove();delete window.__shipGameOff}for(let i=0;i<180;i++)stars.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*2+0.5,v:0.2+Math.random()*0.8});rs();addEventListener('resize',rs);addEventListener('keydown',kd);addEventListener('keyup',ku);c.addEventListener('mousedown',md);window.__shipGameOff=off;loop();})();
